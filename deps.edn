{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}

        com.github.seancorfield/honeysql {:mvn/version "2.7.1399"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        integrant/integrant {:mvn/version "1.0.1"}
        lambdaisland/uri {:mvn/version "1.19.155"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                               lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               nubank/matcher-combinators {:mvn/version "3.10.1"}
                               org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}}
                  :main-opts ["-m" "kaocha.runner"]}

           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}

           ;; clojure -M:clj-kondo --lint src
           :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.05.25"}}
                       :main-opts ["-m" "clj-kondo.main"]}

           ;; clojure -M:cljfmt check|fix
           :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
                    :main-opts ["-m" "cljfmt.main"]}}}
